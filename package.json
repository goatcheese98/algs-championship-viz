{
	"name": "algs-dashboard",
	"version": "4.0.0",
	"private": true,
	"description": "Replay Apex Legends Global Series standings game by game",
	"type": "module",
	"scripts": {
		"data": "node scripts/build-data.mjs",
		"dev": "cf dev -- --port 4630 --strictPort",
		"build": "npm run typecheck && cf build",
		"typecheck": "vp check --no-fmt --no-lint",
		"test": "vp test run",
		"lint": "vp lint --deny-warnings",
		"format": "vp fmt",
		"check": "vp check --deny-warnings && vp test run",
		"deploy": "npm run check && ./scripts/cf-personal deploy"
	},
	"dependencies": {
		"@fontsource-variable/sofia-sans": "^5.3.0",
		"@fontsource-variable/sofia-sans-condensed": "^5.3.0",
		"@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.17",
		"cf": "1.0.0-beta.32",
		"typescript": "^7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plus": "1.6.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vitest": "5.1.0"
	}
}
